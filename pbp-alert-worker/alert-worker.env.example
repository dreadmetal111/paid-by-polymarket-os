# Copy this file to alert-worker.env, then edit alert-worker.env.
# Never paste a real Discord webhook into this example file.

PBP_MARKETS_URL=https://paid-by-polymarket-os.onrender.com/api/liveMarkets
PBP_DATABASE_PATH=pbp-alert-worker.sqlite3
PBP_HOST=0.0.0.0
PBP_PORT=5090
PBP_FETCH_INTERVAL_SECONDS=180
PBP_REQUEST_TIMEOUT_SECONDS=20

# Required for Discord delivery. Leave blank to store alerts locally only.
DISCORD_WEBHOOK_URL=
PBP_DISCORD_ENABLED=true
PBP_DISCORD_USERNAME=PBP Alerts
PBP_DISCORD_AVATAR_URL=
PBP_MAX_DISCORD_ALERTS_PER_CYCLE=10
PBP_ALERT_MAX_PUBLIC_ALERTS_PER_CYCLE=5

# Optional Render public alert bridge. Leave blank to skip Render ingest.
# Never paste a real ingest secret into this example file.
PBP_RENDER_ALERT_INGEST_URL=https://paid-by-polymarket-os.onrender.com/api/internal/alerts
PBP_ALERT_INGEST_SECRET=

# Guarded delivery V2 is intentionally OFF until the receiver schema and
# PBP_ALERT_INGEST_V2_ENABLED have been deployed and verified first.
PBP_ALERT_DELIVERY_V2_ENABLED=false
PBP_ALERT_RETRY_MAX_ATTEMPTS=5
PBP_ALERT_RETRY_TTL_SECONDS=900
PBP_ALERT_RETRY_INITIAL_BACKOFF_SECONDS=30
PBP_ALERT_RETRY_MAX_BACKOFF_SECONDS=300
PBP_ALERT_RETRY_FUTURE_SKEW_SECONDS=60

# Alert safety controls.
# The first run builds a baseline by default. Set true only if you want first-run
# high-volume markets to notify Discord immediately.
PBP_ALERT_ON_FIRST_RUN=false
PBP_ALERT_MARKET_COOLDOWN_MINUTES=60

# Alert thresholds.
PBP_ALERT_MIN_VOLUME=50000
PBP_ALERT_MIN_LIQUIDITY=10000
PBP_ALERT_MIN_PROB_MOVE_PCT=5
PBP_MIN_NEW_MARKET_VOLUME_24H=100000
PBP_VOLUME_SPIKE_MULTIPLIER=2.0
PBP_VOLUME_SPIKE_MIN_CHANGE=25000
PBP_LIQUIDITY_SPIKE_MULTIPLIER=1.5
PBP_LIQUIDITY_SPIKE_MIN_CHANGE=25000

# Legacy aliases still work if they already exist in alert-worker.env:
# PBP_ALERT_COOLDOWN_MINUTES
# PBP_PROBABILITY_MOVE_POINTS

PBP_LOG_LEVEL=INFO

[Unit]
Description=PBP Watchtower v1.2
After=network.target

[Service]
User=dylan
WorkingDirectory=/home/dylan/projects/automation/pbp-watchtower
EnvironmentFile=/home/dylan/projects/automation/pbp-watchtower/watchtower.env
ExecStart=/usr/bin/python3 /home/dylan/projects/automation/pbp-watchtower/pbp_watchtower.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
